---
/**
 * A pool of candidate questions, of which only a few are asked — and the order
 * in which they are asked is itself the decision. The path threads the chosen
 * candidates in sequence.
 *
 * Schematic. The lattice carries no values and the ordinals are positions in a
 * sequence, not measurements.
 */
import { toPath, toSmoothPath, type Point } from '@utils/field';
import '@components/visuals/figure.css';

interface Props {
  width?: number;
  height?: number;
  labels?: boolean;
  title?: string;
  class?: string;
}

const { width = 440, height = 340, labels = false, title, class: className } = Astro.props;

const pad = { l: 40, r: 40, t: 40, b: 52 };
const cols = 7;
const rows = 5;
const stepX = (width - pad.l - pad.r) / (cols - 1);
const stepY = (height - pad.t - pad.b) / (rows - 1);
const at = (c: number, r: number): Point => [pad.l + c * stepX, pad.t + r * stepY];

const candidates: { p: Point; c: number; r: number }[] = [];
for (let r = 0; r < rows; r++) {
  for (let c = 0; c < cols; c++) candidates.push({ p: at(c, r), c, r });
}

/** A fixed, legible route: neither monotone nor obviously arbitrary. */
const route: [number, number][] = [
  [1, 3],
  [3, 1],
  [4, 4],
  [6, 2],
];
const chosen = route.map(([c, r]) => at(c, r));
const chosenKeys = new Set(route.map(([c, r]) => `${c}:${r}`));
const trail = toSmoothPath(chosen, false, 0.55);
const axisY = height - pad.b + 26;
---

<svg
  class:list={['fig', className]}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="xMidYMid meet"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {candidates
    .filter(({ c, r }) => !chosenKeys.has(`${c}:${r}`))
    .map(({ p }) => (
      <circle cx={p[0].toFixed(1)} cy={p[1].toFixed(1)} r="2.6" class="seq__candidate" />
    ))}

  <path d={trail} class="f-signal" stroke-width="1.8" stroke-dasharray="1.5 4" />

  {chosen.map((p, i) => (
    <>
      <circle
        cx={p[0].toFixed(1)}
        cy={p[1].toFixed(1)}
        r={i === 0 ? 5 : 4.5}
        class={i === 0 ? 'f-dot-hollow' : 'f-dot'}
      />
      {labels && (
        <text class="f-tick" x={(p[0] + 11).toFixed(1)} y={(p[1] - 9).toFixed(1)}>
          {i + 1}
        </text>
      )}
    </>
  ))}

  <path
    d={toPath([
      [pad.l, axisY],
      [width - pad.r, axisY],
    ])}
    class="f-axis"
  />
  {chosen.map((p, i) => (
    <>
      <path
        d={toPath([
          [p[0], axisY - 5],
          [p[0], axisY + 5],
        ])}
        class="f-signal"
        stroke-width="1.6"
      />
      <path
        d={toPath([
          [p[0], p[1] + 9],
          [p[0], axisY - 8],
        ])}
        class="seq__drop"
        style={`--order:${i}`}
      />
    </>
  ))}

  {labels && (
    <>
      <text class="f-tick" x={pad.l} y={pad.t - 18}>
        candidate questions
      </text>
      <text class="f-tick" x={pad.l} y={axisY + 22}>
        asked in this order
      </text>
    </>
  )}
</svg>

<style>
  .seq__candidate {
    fill: var(--graph-field);
  }

  .seq__drop {
    stroke: var(--graph-line);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 2 4;
  }
</style>
