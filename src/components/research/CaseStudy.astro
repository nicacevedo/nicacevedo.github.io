---
import ProjectFigure from '@components/research/ProjectFigure.astro';
import { themeById } from '@data/themes';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'research'>;
  index: string;
  /** Alternates the figure between the two sides. */
  flip?: boolean;
}

const { entry, index, flip = false } = Astro.props;
const { data } = entry;
const theme = themeById[data.primaryTheme];
const href = `/projects/${entry.id}/`;
---

<article class:list={['case', flip && 'case--flip']}>
  <div class="case__meta">
    <span class="case__index label">{index}</span>
    <span class="case__theme label">{theme.name}</span>
  </div>

  <div class="case__body">
    <h3 class="case__title">
      <a class="link link--title" href={href}>
        {data.title}
      </a>
    </h3>

    <p class="case__question serif">{data.researchQuestion}</p>
    <p class="case__thesis">{data.thesis}</p>

    <dl class="case__facts">
      <div>
        <dt class="label">Status</dt>
        <dd>{data.status}</dd>
      </div>
      <div>
        <dt class="label">Period</dt>
        <dd>{data.period}</dd>
      </div>
    </dl>

    <a class="arrow-link" href={href}>
      Read the case study<span class="visually-hidden">: {data.title}</span>
    </a>
  </div>

  <figure class="case__figure">
    <div class="case__figure-frame">
      <ProjectFigure visual={data.visual} width={440} height={330} />
    </div>
    <figcaption class="case__caption">{data.visualCaption}</figcaption>
  </figure>
</article>

<style>
  .case {
    display: grid;
    gap: var(--space-6) var(--gutter);
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .case__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .case__index {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .case__title {
    font-size: var(--step-2);
    margin-bottom: var(--space-4);
    max-width: 22ch;
  }

  .case__question {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink);
    max-width: 34ch;
    margin-bottom: var(--space-4);
  }

  .case__thesis {
    color: var(--ink-muted);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }

  .case__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .case__facts dt {
    margin-bottom: 0.2rem;
  }

  .case__facts dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .case__figure {
    margin: 0;
  }

  .case__figure-frame {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .case__caption {
    margin-top: var(--space-3);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--ink-faint);
    max-width: 48ch;
  }

  @media (min-width: 62rem) {
    .case {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }

    .case__meta {
      grid-column: 1 / 3;
      flex-direction: column;
      gap: var(--space-2);
    }

    .case__body {
      grid-column: 3 / 8;
    }

    .case__figure {
      grid-column: 9 / 13;
    }

    .case--flip .case__meta {
      grid-column: 1 / 3;
    }

    .case--flip .case__figure {
      grid-column: 3 / 7;
      grid-row: 1;
    }

    .case--flip .case__body {
      grid-column: 8 / 13;
      grid-row: 1;
    }
  }
</style>
