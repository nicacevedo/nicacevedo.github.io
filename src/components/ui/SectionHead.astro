---
interface Props {
  index?: string;
  title: string;
  /** Renders the title as an h2 by default. */
  as?: 'h2' | 'h3';
  id?: string;
  note?: string;
  class?: string;
}

const { index, title, as: Tag = 'h2', id, note, class: className } = Astro.props;
---

<div class:list={['section-head', className]}>
  {index && (
    <span class="section-head__index" aria-hidden="true">
      {index}
    </span>
  )}
  <Tag class="section-head__title" id={id}>
    {title}
  </Tag>
  {note && <p class="section-head__note">{note}</p>}
</div>

<style>
  /* Scoped styles cannot reach across the component boundary, so the gap below
     a section heading is set here and tuned by pages through an inherited
     custom property rather than a class they cannot style. */
  .section-head {
    margin-bottom: var(--section-head-gap, var(--space-12));
  }

  .section-head__title {
    font-size: var(--step-2);
    margin-right: auto;
  }

  .section-head__note {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 30ch;
  }
</style>
