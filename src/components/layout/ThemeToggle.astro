---
/** Small utility control. Preference is applied before first paint in BaseHead. */
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label="Switch to dark theme"
  aria-pressed="false"
>
  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false" class="theme-toggle__icon">
    <circle cx="10" cy="10" r="4.1" class="theme-toggle__body"></circle>
    <g class="theme-toggle__rays">
      <path d="M10 1.6v2.2M10 16.2v2.2M18.4 10h-2.2M3.8 10H1.6M15.9 4.1l-1.6 1.6M5.7 14.3l-1.6 1.6M15.9 15.9l-1.6-1.6M5.7 5.7L4.1 4.1"></path>
    </g>
    <path
      class="theme-toggle__moon"
      d="M13.4 10.9a4.6 4.6 0 0 1-5.6-5.6 4.8 4.8 0 1 0 5.6 5.6Z"
    ></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Never let a crowded header row shrink a control below its target size. */
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--line);
  }

  .theme-toggle__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .theme-toggle__body {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .theme-toggle__rays path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .theme-toggle__moon {
    display: none;
    fill: currentColor;
  }

  /* In dark theme the control shows the moon, so its state is legible
     without relying on color alone. */
  :global(:root[data-theme='dark']) .theme-toggle__body,
  :global(:root[data-theme='dark']) .theme-toggle__rays {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__body,
    :global(:root:not([data-theme='light'])) .theme-toggle__rays {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: block;
    }
  }
</style>
