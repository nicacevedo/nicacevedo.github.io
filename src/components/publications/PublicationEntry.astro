---
import { formatAuthors, type Publication } from '@utils/publications';

interface Props {
  publication: Publication;
  index: number;
}

const { publication, index } = Astro.props;
---

<li class="pub">
  <div class="pub__rail">
    <span class="pub__year label">{publication.year}</span>
    <span class="pub__kind label">{publication.kindLabel}</span>
  </div>

  <div class="pub__body">
    <h3 class="pub__title">{publication.title}</h3>

    <p class="pub__authors">
      {publication.authors.map((author, i) => (
        <span
          class:list={['pub__author', author.isSelf && 'is-self']}
          data-sep={i < publication.authors.length - 1 ? ',' : ''}
          set:text={author.name}
        />
      ))}
    </p>

    {publication.venue && <p class="pub__venue">{publication.venue}</p>}
    {publication.note && <p class="pub__note">{publication.note}</p>}

    <div class="chip-row pub__links">
      {publication.links.map((link) => {
        const external = link.href.startsWith('http');
        return (
          <a
            class="chip"
            href={link.href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
          >
            {link.label}
            {external && <span class="visually-hidden"> (opens in a new tab)</span>}
          </a>
        );
      })}
      {publication.projectSlug && (
        <a class="chip" href={`/projects/${publication.projectSlug}/`}>
          Research
        </a>
      )}
    </div>

    <details class="bibtex">
      <summary class="bibtex__summary">
        BibTeX<span class="visually-hidden"> for {publication.title}</span>
      </summary>
      <pre class="bibtex__code"><code>{publication.bibtex}</code></pre>
    </details>
  </div>
</li>

<style>
  .pub {
    display: grid;
    gap: var(--space-3) var(--gutter);
    padding-block: var(--space-8);
    border-top: 1px solid var(--line);
  }

  .pub:first-child {
    border-top-color: var(--ink);
  }

  .pub__rail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .pub__year {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .pub__kind {
    color: var(--ink-faint);
  }

  .pub__title {
    font-size: var(--step-2);
    line-height: 1.2;
    max-width: 30ch;
    margin-bottom: var(--space-3);
  }

  .pub__authors {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: var(--space-1);
  }

  .pub__author.is-self {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__author[data-sep=',']::after {
    content: ', ';
    font-weight: 400;
    color: var(--ink-muted);
  }

  .pub__venue {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .pub__note {
    font-size: var(--step--2);
    color: var(--ink-faint);
    max-width: 60ch;
    line-height: 1.55;
  }

  .pub__links {
    margin-top: var(--space-4);
  }

  .bibtex {
    margin-top: var(--space-4);
  }

  .bibtex__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.25rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
  }

  .bibtex__summary::-webkit-details-marker {
    display: none;
  }

  .bibtex__summary::before {
    content: '+';
    font-family: var(--font-mono);
    line-height: 1;
  }

  .bibtex[open] .bibtex__summary::before {
    content: '−';
  }

  .bibtex__summary:hover {
    color: var(--signal);
  }

  .bibtex__code {
    margin-top: var(--space-3);
    padding: var(--space-4);
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-muted);
    white-space: pre;
  }

  @media (min-width: 48rem) {
    .pub {
      grid-template-columns: 11rem minmax(0, 1fr);
    }

    .pub__rail {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
