---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '@layouts/Base.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import { themeById } from '@data/themes';
import { profile } from '@data/profile';
import { getPublications, formatAuthors } from '@utils/publications';

export async function getStaticPaths() {
  const projects = await getCollection('research');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const theme = themeById[data.primaryTheme];

const publications = getPublications().filter((p) => p.projectSlug === entry.id);

/** Real figures live in src/assets and are resolved by filename at build time. */
const assets = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp}');
const figureLoader = data.figure ? assets[`/src/assets/${data.figure.src}`] : undefined;
const figureImage = figureLoader ? (await figureLoader()).default : undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.title,
  description: data.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  about: theme.name,
  author: { '@type': 'Person', name: profile.name, url: `${profile.siteUrl}/` },
  isPartOf: {
    '@type': 'WebSite',
    name: profile.name,
    url: `${profile.siteUrl}/`,
  },
};
---

<Base
  title={data.title}
  description={data.description}
  ogImage={entry.id}
  ogType="article"
  schema={schema}
>
  <article class="project">
    <header class="project__head">
      <div class="shell project__masthead">
        <div class="project__lede">
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol class="list-reset">
              <li>
                <a href="/research/">Research</a>
              </li>
            </ol>
          </nav>

          <h1 class="project__title">{data.title}</h1>
          <p class="project__thesis serif">{data.thesis}</p>
        </div>
      </div>

      <div class="shell">
        <dl class="project__facts">
          <div class="project__fact">
            <dt class="label">Status</dt>
            <dd>{data.status}</dd>
          </div>
          <div class="project__fact">
            <dt class="label">Period</dt>
            <dd>{data.period}</dd>
          </div>
        </dl>

        {data.outputs.length > 0 && (
          <div class="project__outputs">
            <h2 class="label project__outputs-title">Public outputs</h2>
            <div class="chip-row">
              {data.outputs.map((output) => {
                const external = output.href.startsWith('http');
                return (
                  <a
                    class="chip"
                    href={output.href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener' : undefined}
                  >
                    {output.label}
                    {external && <span class="visually-hidden"> (opens in a new tab)</span>}
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </header>

    <div class="shell project__grid">
      <div class="project__aside">
        <div class="project__question">
          <h2 class="label">Research question</h2>
          <p>{data.researchQuestion}</p>
        </div>
      </div>

      <div class="project__prose prose">
        <Content />

        {data.figure && figureImage && (
          <figure class="evidence">
            <div class="evidence__plate">
              <Picture
                src={figureImage}
                formats={['avif', 'webp']}
                widths={[560, 1112]}
                sizes="(min-width: 62rem) 40vw, 92vw"
                alt={data.figure.alt}
                loading="lazy"
                class="evidence__img"
              />
            </div>
            <figcaption class="evidence__caption">
              {data.figure.caption}{' '}
              <a class="link" href={data.figure.sourceHref}>
                {data.figure.source}
              </a>
            </figcaption>
          </figure>
        )}
      </div>
    </div>

    {publications.length > 0 && (
      <section class="band" aria-labelledby="project-pubs">
        <div class="shell">
          <SectionHead title="Publications" id="project-pubs" />
          <ol class="list-reset pub-list">
            {publications.map((publication) => (
              <li class="pub">
                <p class="pub__kind label">
                  {publication.kindLabel} · {publication.year}
                </p>
                <h3 class="pub__title">{publication.title}</h3>
                <p class="pub__meta">
                  {formatAuthors(publication.authors)}
                  {publication.venue && ` · ${publication.venue}`}
                </p>
                <p class="band__more">
                  <a class="arrow-link" href="/publications/">
                    See it on Publications
                  </a>
                </p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .project__head {
    padding-block: clamp(var(--space-8), 5vw, var(--space-16)) var(--space-12);
  }

  .project__masthead {
    display: grid;
    gap: var(--space-10, var(--space-8)) var(--gutter);
    align-items: start;
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
  }

  .crumbs ol {
    display: flex;
    gap: var(--space-2);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    margin-bottom: var(--space-8);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--signal);
  }

  .project__title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 18ch;
    margin-bottom: var(--space-6);
  }

  .project__thesis {
    font-size: var(--step-2);
    line-height: 1.35;
    max-width: 38ch;
    color: var(--ink);
  }

  .project__facts {
    display: grid;
    gap: var(--space-4) var(--gutter);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
    margin-bottom: var(--space-8);
  }

  .project__fact dt {
    margin-bottom: var(--space-2);
  }

  .project__fact dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.4;
  }

  .project__outputs-title {
    display: block;
    margin-bottom: var(--space-3);
  }

  .project__grid {
    display: grid;
    gap: var(--space-12) var(--gutter);
  }

  .project__question {
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }

  .project__question h2 {
    display: block;
    margin-bottom: var(--space-3);
  }

  .project__question p {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 32ch;
  }

  .evidence {
    margin-top: var(--space-12);
  }

  /* A reproduction, so it keeps its own paper in both themes rather than
     pretending to be part of the interface. */
  .evidence__plate {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .evidence__img {
    width: 100%;
    height: auto;
  }

  .evidence__caption {
    margin-top: var(--space-3);
    font-size: var(--step--2);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 58ch;
  }

  .project__prose :global(h2) {
    font-size: var(--step-2);
  }

  .project__prose :global(h2:first-child) {
    margin-top: 0;
  }

  @media (min-width: 48rem) {
    .project__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .project__masthead {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .project__lede {
      grid-column: 1 / 10;
    }

    .project__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .project__aside {
      grid-column: 1 / 5;
      position: sticky;
      top: 6rem;
    }

    .project__prose {
      grid-column: 6 / 13;
    }
  }

  .band {
    --section-head-gap: var(--space-8);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) 0;
  }

  .band__more {
    margin-top: var(--space-4);
  }

  .pub {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .pub__kind {
    margin-bottom: var(--space-2);
  }

  .pub__title {
    font-size: var(--step-1);
    max-width: 46ch;
    margin-bottom: var(--space-2);
  }

  .pub__meta {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 60ch;
  }
</style>
