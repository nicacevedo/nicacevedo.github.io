---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import DecisionLandscape from '@components/visuals/DecisionLandscape.astro';
import ThemeGrid from '@components/research/ThemeGrid.astro';
import CaseStudy from '@components/research/CaseStudy.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import UpdateList from '@components/ui/UpdateList.astro';
import { profile } from '@data/profile';
import { practice } from '@data/practice';
import { getSelectedOutputs } from '@utils/outputs';
import portrait from '@assets/portrait.jpg';

const featured = (await getCollection('research'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const updates = (await getCollection('updates'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const outputs = (await getSelectedOutputs()).slice(0, 5);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: new Date().toISOString().slice(0, 10),
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: `${profile.siteUrl}/`,
    email: `mailto:${profile.email}`,
    jobTitle: profile.role,
    description: profile.summary,
    affiliation: {
      '@type': 'CollegeOrUniversity',
      name: 'Massachusetts Institute of Technology',
      url: 'https://www.mit.edu/',
    },
    alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidad de Chile' }],
    knowsAbout: [
      'Operations research',
      'Optimization',
      'Equitable prediction',
      'Infrastructure systems',
      'Large-scale optimization',
    ],
    sameAs: profile.socials.filter((s) => s.external).map((s) => s.href),
  },
};
---

<Base
  title={`${profile.name} — ${profile.statement}`}
  description={profile.description}
  ogImage="home"
  schema={schema}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell">
      <p class="hero__meta">
        <span class="label">{profile.affiliation}</span>
        <span class="label hero__meta-end">{profile.location}</span>
      </p>

      <div class="hero__top">
        <h1 class="hero__title" id="hero-title">
          <span class="hero__name">{profile.name}</span>
          <span class="hero__statement">
            <span class="hero__line">Optimization for</span>
            <span class="hero__line">
              <em class="serif">consequential</em>
            </span>
            <span class="hero__line">decisions.</span>
          </span>
        </h1>

        <div class="hero__figure">
          <DecisionLandscape interactive />
        </div>
      </div>

      <div class="hero__band">
        <figure class="hero__portrait">
          <Picture
            src={portrait}
            formats={['avif', 'webp']}
            widths={[300, 450, 600]}
            sizes="(min-width: 62rem) 18vw, (min-width: 48rem) 26vw, 46vw"
            alt={`${profile.name}, photographed outdoors on a ridge.`}
            loading="eager"
            fetchpriority="high"
            class="hero__portrait-img"
          />
          <figcaption class="hero__portrait-caption">{profile.role}</figcaption>
        </figure>

        <div class="hero__intro">
          <p class="hero__summary">{profile.summary}</p>

          <div class="hero__actions">
            <a class="btn" href="/research/">
              Explore research
            </a>
            <a class="btn btn--ghost" href={profile.cvPdf}>
              Curriculum vitae
              <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(PDF)</span>
            </a>
          </div>
        </div>

        <div class="hero__rail">
          <h2 class="label hero__rail-title">Elsewhere</h2>
          <ul class="hero__socials list-reset">
            {profile.socials.map((social) => (
              <li>
                <a
                  class="link"
                  href={social.href}
                  rel={social.external ? 'me noopener' : 'me'}
                  target={social.external ? '_blank' : undefined}
                >
                  {social.short}
                  {social.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="themes-title">
    <div class="shell">
      <SectionHead index="01" title="Research themes" id="themes-title" class="band__head" />
      <ThemeGrid linked />
    </div>
  </section>

  <section class="band" aria-labelledby="featured-title">
    <div class="shell">
      <SectionHead
        index="02"
        title="Featured research"
        id="featured-title"
        note="Three active directions, each with a public repository."
        class="band__head"
      />
      <div class="cases">
        {featured.map((entry, i) => (
          <CaseStudy entry={entry} index={String(i + 1).padStart(2, '0')} flip={i % 2 === 1} />
        ))}
      </div>
      <p class="band__more">
        <a class="arrow-link" href="/research/">
          All research, including earlier work
        </a>
      </p>
    </div>
  </section>

  {practice.length > 0 && (
    <section class="band practice" aria-labelledby="practice-title">
      <div class="shell">
        <SectionHead
          index="03"
          title="Research to practice"
          id="practice-title"
          class="band__head"
        />
        {practice.map((record) => (
          <div class="practice__row">
            <div class="practice__when">
              <span class="label">{record.date}</span>
              <p class="practice__org">{record.organization}</p>
            </div>
            <div class="practice__what">
              <p class="practice__claim">{record.claim}</p>
              <p class="practice__detail">
                The objective is selectable in the model configuration as <code>mse_cov</code>. This
                records a change to a public codebase, not a measured effect on assessments or
                policy.
              </p>
              <div class="chip-row">
                <a class="chip" href={record.evidenceHref} target="_blank" rel="noopener">
                  {record.evidenceLabel}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
                <a class="chip" href={`/projects/${record.projectSlug}/`}>
                  Related research
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="band" aria-labelledby="outputs-title">
    <div class="shell">
      <SectionHead index="04" title="Selected outputs" id="outputs-title" class="band__head" />
      <ol class="outputs list-reset">
        {outputs.map((output) => (
          <li class="output">
            <span class="output__year label">{output.year}</span>
            <div class="output__body">
              <p class="output__kind label">{output.kind}</p>
              <h3 class="output__title">
                <a
                  class="link link--title"
                  href={output.href}
                  target={output.external ? '_blank' : undefined}
                  rel={output.external ? 'noopener' : undefined}
                >
                  {output.title}
                  {output.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </h3>
              <p class="output__meta">{output.meta}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="band__more">
        <a class="arrow-link" href="/publications/">
          All publications and research outputs
        </a>
      </p>
    </div>
  </section>

  <section class="band" aria-labelledby="currently-title">
    <div class="shell">
      <SectionHead index="05" title="Currently" id="currently-title" class="band__head" />
      <div class="currently">
        <div class="currently__now">
          <p class="currently__lead serif">
            PhD student at the MIT Operations Research Center, since September 2024.
          </p>
          <p class="currently__advising">
            Advised by {profile.advising.current.join(' and ')}. Earlier in the PhD I also received
            research guidance from {profile.advising.past.join(' and ')}.
          </p>
          <p class="currently__more">
            <a class="arrow-link" href="/about/">
              More about my background
            </a>
          </p>
        </div>

        <div class="currently__history">
          <h3 class="currently__heading label">Education</h3>
          <ol class="chrono list-reset">
            {profile.education.map((item) => (
              <li class="chrono__item">
                <span class="chrono__period label">{item.period}</span>
                <span class="chrono__role">{item.role}</span>
                <span class="chrono__org">{item.org}</span>
              </li>
            ))}
          </ol>

          <h3 class="currently__heading label">Selected experience</h3>
          <ol class="chrono list-reset">
            {profile.experience.map((item) => (
              <li class="chrono__item">
                <span class="chrono__period label">{item.period}</span>
                <span class="chrono__role">{item.role}</span>
                <span class="chrono__org">{item.org}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="updates-title">
    <div class="shell">
      <SectionHead index="06" title="Updates" id="updates-title" class="band__head" />
      <UpdateList entries={updates} />
      <p class="band__more">
        <a class="arrow-link" href="/updates/">
          All updates
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */

  .hero {
    padding-block: clamp(var(--space-6), 4vw, var(--space-16)) var(--space-16);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--ink);
    margin-bottom: clamp(var(--space-8), 5vw, var(--space-16));
  }

  @media (min-width: 34rem) {
    .hero__meta-end {
      margin-left: auto;
    }
  }

  .hero__top {
    display: grid;
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }

  .hero__name {
    display: block;
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }

  .hero__statement {
    display: block;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .hero__line {
    display: block;
  }

  .hero__statement em {
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.018em;
  }

  .hero__figure {
    max-width: 34rem;
    width: 100%;
    justify-self: end;
  }

  .hero__band {
    display: grid;
    gap: var(--space-8) var(--gutter);
    padding-top: var(--space-6);
    margin-top: clamp(var(--space-8), 5vw, var(--space-16));
    border-top: 1px solid var(--ink);
  }

  .hero__portrait {
    margin: 0;
    max-width: 13rem;
  }

  .hero__portrait-img {
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    width: 100%;
    height: auto;
  }

  .hero__portrait-caption {
    margin-top: var(--space-3);
    display: block;
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.4;
    max-width: 17ch;
  }

  .hero__summary {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 32ch;
    margin-bottom: var(--space-6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__rail-title {
    display: block;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-3);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .hero__band {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      align-items: start;
    }

    .hero__portrait {
      grid-column: 1 / 3;
      max-width: none;
    }

    .hero__intro {
      grid-column: 3 / 7;
    }

    .hero__rail {
      grid-column: 3 / 7;
    }

    .hero__socials {
      flex-direction: row;
    }
  }

  @media (min-width: 62rem) {
    .hero__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .hero__title {
      grid-column: 1 / 8;
    }

    .hero__figure {
      grid-column: 8 / 13;
      max-width: none;
    }

    .hero__band {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .hero__portrait {
      grid-column: 1 / 4;
    }

    .hero__intro {
      grid-column: 4 / 9;
    }

    .hero__rail {
      grid-column: 10 / 13;
    }

    .hero__socials {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  /* ---------- Sections ---------- */

  .band {
    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) 0;
  }

  .band__head {
    margin-bottom: var(--space-12);
  }

  .band__more {
    margin-top: var(--space-8);
  }

  .cases {
    display: grid;
    gap: clamp(var(--space-16), 8vw, var(--space-24));
  }

  /* ---------- Research to practice ---------- */

  .practice__row {
    display: grid;
    gap: var(--space-4) var(--gutter);
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .practice__org {
    font-size: var(--step-1);
    font-weight: 550;
    letter-spacing: -0.015em;
    margin-top: var(--space-2);
    max-width: 14ch;
  }

  .practice__claim {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
    margin-bottom: var(--space-4);
  }

  .practice__detail {
    color: var(--ink-muted);
    font-size: var(--step--1);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }

  @media (min-width: 62rem) {
    .practice__row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .practice__when {
      grid-column: 1 / 4;
    }

    .practice__what {
      grid-column: 5 / 12;
    }
  }

  /* ---------- Outputs ---------- */

  .output {
    display: grid;
    gap: var(--space-1) var(--gutter);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .output:first-child {
    border-top-color: var(--ink);
  }

  .output__year {
    font-variant-numeric: tabular-nums;
    padding-top: 0.25em;
  }

  .output__kind {
    margin-bottom: var(--space-2);
    color: var(--ink-faint);
  }

  .output__title {
    font-size: var(--step-1);
    line-height: 1.3;
    max-width: 46ch;
    margin-bottom: var(--space-2);
  }

  .output__meta {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 58ch;
  }

  @media (min-width: 48rem) {
    .output {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }

  /* ---------- Currently ---------- */

  .currently {
    display: grid;
    gap: var(--space-12) var(--gutter);
  }

  .currently__lead {
    font-size: var(--step-2);
    line-height: 1.25;
    max-width: 24ch;
    margin-bottom: var(--space-4);
  }

  .currently__advising {
    color: var(--ink-muted);
    max-width: 44ch;
    margin-bottom: var(--space-6);
  }

  .currently__heading {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    margin-bottom: var(--space-4);
    display: block;
  }

  .currently__heading + .chrono {
    margin-bottom: var(--space-8);
  }

  .chrono__item {
    display: grid;
    gap: 0.1rem var(--gutter);
    padding-block: var(--space-3);
  }

  .chrono__item + .chrono__item {
    border-top: 1px solid var(--line);
  }

  .chrono__period {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15em;
  }

  .chrono__role {
    font-weight: 500;
    font-size: var(--step--1);
  }

  .chrono__org {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  @media (min-width: 34rem) {
    .chrono__item {
      grid-template-columns: 10rem minmax(0, 1fr);
    }

    .chrono__period {
      grid-row: span 2;
    }
  }

  @media (min-width: 62rem) {
    .currently {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .currently__now {
      grid-column: 1 / 6;
    }

    .currently__history {
      grid-column: 6 / 13;
    }
  }
</style>
