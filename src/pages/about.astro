---
import { Picture } from 'astro:assets';
import Base from '@layouts/Base.astro';
import SectionHead from '@components/ui/SectionHead.astro';
import { profile } from '@data/profile';
import { cv } from '@data/cv';
import { teaching } from '@data/teaching';
import portraitWide from '@assets/portrait-wide.jpg';

const mitCourses = teaching.mit.length;
const uchileCourses = teaching.uchileGraduate.length + teaching.uchileUndergraduate.length;
---

<Base
  title="About"
  description={`About ${profile.name} — background, research perspective, education and experience.`}
  ogImage="about"
>
  <section class="head">
    <div class="shell">
      <p class="label head__eyebrow">About</p>
      <h1 class="head__title">Nicolás Acevedo Villena</h1>
      <p class="head__role">
        {profile.role} · {profile.affiliation}
      </p>
    </div>
  </section>

  <section class="band">
    <div class="shell about__grid">
      <div class="about__prose prose">
        <p class="about__opening">
          I study how optimization and data-driven modeling can support consequential operational
          and policy decisions. My current research spans equitable predictive modeling for property
          assessment, public-data modeling of data-center infrastructure and resource systems, and
          reliable large-scale first-order optimization on GPUs. Across these settings I use
          optimization and data-driven modeling to make trade-offs explicit and to evaluate methods
          under realistic operational conditions.
        </p>

        <p>
          I came to MIT from the Universidad de Chile, where I completed a master's in operations
          management and a bachelor's in industrial engineering. My master's thesis — a
          column-generation decomposition for large-scale feature selection — is where the interest
          in scalable convex optimization started. Between degrees I worked as a research engineer
          at Nezasa AG in Zurich on time-dependent routing, and as a researcher with the Web
          Intelligence Centre and ACHS on demand forecasting and capacity planning for a hospital in
          Santiago.
        </p>

        <h2>Research perspective</h2>

        <p>
          The three areas I work in look unrelated from outside: property assessment, the water and
          power footprint of data centers, and first-order solvers on GPUs. The question underneath
          them is the same. Each is a computation that a decision rests on, and in each the useful
          work is being precise about what the computation can and cannot support — which errors are
          systematic rather than random, which quantities are reported rather than modeled, which
          residual reflects the algorithm rather than the arithmetic.
        </p>

        <p>
          That is also why the methods stay close to optimization. Once a criterion can be written
          down — an equity measure, a physical constraint, a termination tolerance — it can be made
          part of the problem being solved rather than a check performed afterwards, and the
          trade-off becomes something chosen instead of something discovered.
        </p>

        <h2>Research and advising</h2>

        <p>
          I am advised by {profile.advising.current.join(' and ')} at the MIT Operations Research
          Center. Earlier in the PhD I also received research guidance from{' '}
          {profile.advising.past.join(' and ')}. Before MIT I worked with Fernando Ordóñez and
          Renaud Chicoisne on decomposition methods for feature selection, and with Charles Thraves
          and Ricardo Montoya at the Complex Engineering Systems Institute.
        </p>

        <h2>Teaching</h2>

        <p>
          I have been a teaching assistant for {mitCourses} courses at MIT Sloan and {uchileCourses}{' '}
          at the Universidad de Chile, across optimization, probability, statistics and operations
          management. Several of the recitations I recorded in Santiago are public.
        </p>

        <p>
          <a class="arrow-link" href="/teaching/">
            Teaching record and recitation videos
          </a>
        </p>
      </div>

      <aside class="about__rail" aria-label="Background summary">
        <div class="rail__block">
          <h2 class="label rail__heading">Education</h2>
          <ol class="rail__list list-reset">
            {cv.education.map((item) => (
              <li class="rail__item">
                <span class="rail__period label">{item.period}</span>
                <span class="rail__role">{item.role}</span>
                <span class="rail__org">{item.org}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="rail__block">
          <h2 class="label rail__heading">Selected experience</h2>
          <ol class="rail__list list-reset">
            {cv.experience.map((item) => (
              <li class="rail__item">
                <span class="rail__period label">{item.period}</span>
                <span class="rail__role">{item.role}</span>
                <span class="rail__org">
                  {item.org}
                  {item.place && ` · ${item.place}`}
                </span>
              </li>
            ))}
          </ol>
        </div>

        <div class="rail__block">
          <h2 class="label rail__heading">Elsewhere</h2>
          <ul class="rail__links list-reset">
            {profile.socials.map((social) => (
              <li>
                <a
                  class="link"
                  href={social.href}
                  rel={social.external ? 'me noopener' : 'me'}
                  target={social.external ? '_blank' : undefined}
                >
                  {social.short}
                  {social.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
            <li>
              <a class="link" href="/cv/">
                Full CV
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="band">
    <div class="shell">
      <SectionHead index="02" title="Outside research" class="band__head" />
      <div class="outside">
        <p class="outside__text">
          Music, climbing and time outdoors — usually somewhere with a view worth the walk.
        </p>
        <figure class="outside__figure">
          <Picture
            src={portraitWide}
            formats={['avif', 'webp']}
            widths={[420, 791]}
            sizes="(min-width: 62rem) 46vw, 92vw"
            alt={`${profile.name} outdoors on a ridge, with a mountain slope behind.`}
            loading="lazy"
            class="outside__img"
          />
        </figure>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-block: clamp(var(--space-8), 5vw, var(--space-16)) var(--space-8);
  }

  .head__eyebrow {
    margin-bottom: var(--space-6);
  }

  .head__title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .head__role {
    color: var(--ink-muted);
    font-size: var(--step-1);
  }

  .band {
    padding-block: clamp(var(--space-8), 5vw, var(--space-16)) 0;
  }

  .band__head {
    margin-bottom: var(--space-8);
  }

  .about__grid {
    display: grid;
    gap: var(--space-16) var(--gutter);
    padding-top: var(--space-6);
    border-top: 1px solid var(--ink);
  }

  .about__opening {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .about__prose :global(h2) {
    font-size: var(--step-2);
  }

  .rail__block + .rail__block {
    margin-top: var(--space-12);
  }

  .rail__heading {
    display: block;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--space-4);
  }

  .rail__item {
    display: grid;
    gap: 0.1rem;
    padding-block: var(--space-3);
  }

  .rail__item + .rail__item {
    border-top: 1px solid var(--line);
  }

  .rail__period {
    font-variant-numeric: tabular-nums;
  }

  .rail__role {
    font-weight: 500;
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .rail__org {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .rail__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--step--1);
  }

  .outside {
    display: grid;
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }

  .outside__text {
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  .outside__figure {
    margin: 0;
  }

  .outside__img {
    border-radius: var(--radius-md);
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-sunken);
  }

  @media (min-width: 62rem) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .about__prose {
      grid-column: 1 / 7;
    }

    .about__rail {
      grid-column: 8 / 13;
    }

    .outside {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .outside__text {
      grid-column: 1 / 5;
    }

    .outside__figure {
      grid-column: 6 / 13;
    }
  }
</style>
