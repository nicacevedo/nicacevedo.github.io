---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import ProjectRow from '@components/research/ProjectRow.astro';
import SectionHead from '@components/ui/SectionHead.astro';

const projects = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const current = projects.filter((p) => p.data.stage === 'current');
const earlier = projects.filter((p) => p.data.stage === 'earlier');
---

<Base
  title="Research"
  description="Current and earlier research projects by Nicolás Acevedo Villena."
  ogImage="research"
>
  <section class="intro">
    <div class="shell">
      <h1 class="intro__title">Research</h1>
    </div>
  </section>

  <section class="band" aria-labelledby="current-title">
    <div class="shell">
      <SectionHead title="Current research" id="current-title" />
      {current.map((entry) => (
        <ProjectRow entry={entry} />
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="earlier-title">
    <div class="shell">
      <SectionHead title="Earlier research" id="earlier-title" />
      {earlier.map((entry) => (
        <ProjectRow entry={entry} />
      ))}
      <p class="band__more">
        <a class="arrow-link" href="/publications/">
          Publications
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(var(--space-8), 5vw, var(--space-16)) 0;
  }

  .intro__title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .band {
    --section-head-gap: var(--space-12);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24)) 0;
  }

  .band__more {
    margin-top: var(--space-8);
  }
</style>
