<div class="col mb-4">
  <div class="card h-100 hoverable">
    <div class="row no-gutters">
      {% if project.img %}
        <div class="col-md-6">
          <a
            href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
            aria-label="View research project: {{ project.title }}"
          >
            {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt=project.title class="card-img" %}
          </a>
        </div>
      {% endif %}
      <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <h3 class="card-title">
            <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">{{ project.title }}</a>
          </h3>
          <p class="card-text">{{ project.description }}</p>
          {% if project.status or project.period %}
            <p class="card-text text-muted mb-0">
              <small>
                {% if project.status -%}
                  <strong>{{ project.status }}</strong>
                {%- endif %}
                {% if project.status and project.period %} · {% endif %}
                {{ project.period }}
              </small>
            </p>
          {% endif %}
          {% if project.github %}
            <p class="card-text mt-2 mb-0">
              <small>
                <i class="fa-brands fa-github" aria-hidden="true"></i>
                <a href="{{ project.github }}" target="_blank" rel="noopener"
                  >Code / project repository<span class="sr-only"> (opens in a new tab)</span></a
                >
              </small>
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
