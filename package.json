{
  "name": "nicacevedo-github-io",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal research website of Nicolás Acevedo Villena.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run icons && npm run og",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "og": "node --experimental-strip-types scripts/generate-og.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:install": "playwright install --with-deps chromium firefox webkit",
    "serve": "node scripts/serve.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "budget": "node scripts/check-budget.mjs",
    "links": "node scripts/check-external-links.mjs",
    "production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@retorquere/bibtex-parser": "^11.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  }
}
